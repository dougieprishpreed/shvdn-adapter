#include <winver.h>
#include "resource.h"

// Paths are relative to the include directory passed by build.sh (the managed build output).
IDR_PATCHER RCDATA "ShvdnCompat.Patcher.exe"
IDR_CECIL RCDATA "Mono.Cecil.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ScriptHookVDotNet legacy compatibility layer (GTA V Legacy)"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "ShvdnLegacyCompat"
            VALUE "OriginalFilename", "ShvdnLegacyCompat.asi"
            VALUE "ProductName", "ShvdnLegacyCompat"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
