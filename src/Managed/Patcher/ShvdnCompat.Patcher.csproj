<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 is what runs inside GTA5.exe; net8.0 is only used by the tests on the build machine. -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>ShvdnCompat.Patcher</AssemblyName>
    <RootNamespace>ShvdnCompat</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <!-- The ASI runs the net48 build as its own process; the net8.0 build is a library for the tests. -->
    <OutputType Condition="'$(TargetFramework)' == 'net48'">Exe</OutputType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShvdnCompat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the shim assemblies first and embed them; they are read with Cecil, never loaded. -->
    <ProjectReference Include="..\Shims.V2\Shims.V2.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48" />
    <ProjectReference Include="..\Shims.V3\Shims.V3.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=net48" />
    <EmbeddedResource Include="..\Shims.V2\bin\$(Configuration)\net48\ShvdnCompat.Shims.V2.dll" LogicalName="ShvdnCompat.Shims.V2.dll" />
    <EmbeddedResource Include="..\Shims.V3\bin\$(Configuration)\net48\ShvdnCompat.Shims.V3.dll" LogicalName="ShvdnCompat.Shims.V3.dll" />
  </ItemGroup>

</Project>
