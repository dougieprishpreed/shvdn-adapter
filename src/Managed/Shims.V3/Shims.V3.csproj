<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ShvdnCompat.Shims.V3</AssemblyName>
    <RootNamespace>ShvdnCompat.Shims.V3</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ShimAttributes.cs" Link="ShimAttributes.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only: the shims are written against the current nightly API surface. -->
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>..\..\..\ref\nightly\ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
